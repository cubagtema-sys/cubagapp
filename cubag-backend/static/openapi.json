{
  "openapi": "3.0.3",
  "info": {
    "title": "CUBAG Public REST API",
    "version": "1.0.0",
    "description": "Official Developer & Public REST API for CUBAG (Customs Brokers Association of Ghana). Provides real-time accredited member standing verification, tamper-evident cryptographic payment receipt validation, maritime vessel schedules, port operational news, and formal trade dispute tracking.",
    "contact": {
      "name": "CUBAG Tech Desk & Secretariat",
      "email": "tech@cubag.org",
      "url": "https://cubag-api-server.fly.dev"
    },
    "license": {
      "name": "Proprietary / CUBAG Secretariat 2026"
    }
  },
  "servers": [
    {
      "url": "https://cubag-api-server.fly.dev",
      "description": "Production Fly.io Cluster (24/7 Always Active)"
    },
    {
      "url": "http://localhost:5005",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Composite & Portal",
      "description": "Aggregated homepage views and high-level association metrics"
    },
    {
      "name": "Verification",
      "description": "Accredited membership standing and cryptographic payment verification"
    },
    {
      "name": "Grievances & Complaints",
      "description": "Formal trade grievance lodgement and status progression tracking"
    },
    {
      "name": "Directory & Ports",
      "description": "Accredited corporate brokerage firms and operating ports in Ghana"
    },
    {
      "name": "Publications & Events",
      "description": "CTI training courses, trade press releases, port bulletins, and public surveys"
    },
    {
      "name": "System & Health",
      "description": "Gateway uptime and latency checks"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System & Health"
        ],
        "summary": "API Gateway Health Check",
        "description": "Returns 200 OK when the backend server is operational and database pool is active.",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "CUBAG API is running"
                }
              }
            }
          }
        }
      }
    },
    "/api/ping": {
      "get": {
        "tags": [
          "System & Health"
        ],
        "summary": "Latency Ping",
        "description": "Lightweight latency ping probe.",
        "responses": {
          "200": {
            "description": "Pong response",
            "content": {
              "text/plain": {
                "example": "pong"
              }
            }
          }
        }
      }
    },
    "/api/v1/public/portal-summary": {
      "get": {
        "tags": [
          "Composite & Portal"
        ],
        "summary": "Composite Portal Summary",
        "description": "Aggregates hero banner, top association stats, news feeds, upcoming events, CTI courses, and active surveys in a single roundtrip to power website homepages.",
        "responses": {
          "200": {
            "description": "Composite portal payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/stats": {
      "get": {
        "tags": [
          "Composite & Portal"
        ],
        "summary": "Key Association Statistics",
        "description": "Returns quick public statistics: total accredited members, operating ports, compliance rate, and certified customs brokers.",
        "responses": {
          "200": {
            "description": "Statistics object",
            "content": {
              "application/json": {
                "example": {
                  "active_members": 152,
                  "operating_ports": 4,
                  "compliance_rate": 98,
                  "certified_brokers": 340
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/verify-member": {
      "get": {
        "tags": [
          "Verification"
        ],
        "summary": "Verify Member Standing",
        "description": "Checks if a company or individual has active accredited standing with CUBAG. Accepts CUBAG Member ID (e.g. CUBAG-2026-0008), company name, or TIN.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "CUBAG ID (e.g. CUBAG-2026-0008) or Company Name (e.g. ANTWI NYAME)",
            "schema": {
              "type": "string"
            },
            "example": "CUBAG-2026-0008"
          }
        ],
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyMemberResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/verify-receipt": {
      "get": {
        "tags": [
          "Verification"
        ],
        "summary": "Verify Payment Receipt",
        "description": "Validates the cryptographic authenticity of an official CUBAG digital receipt using its 32-character SHA-256 validation token.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "32-character cryptographic token printed on receipt or QR code",
            "schema": {
              "type": "string"
            },
            "example": "943d21ee5518af43ba4a9fa039b173ef"
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "description": "Optional amount check for double-entry verification (e.g. 1383.00)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt verification result",
            "content": {
              "application/json": {
                "example": {
                  "valid": true,
                  "receipt": {
                    "receipt_number": "REC-2026-0089",
                    "payment_category": "Annual Renewal Dues",
                    "amount": 1383.0,
                    "payer_name": "Apex Logistics Ghana Ltd",
                    "payment_date": "2026-11-08T14:22:10Z",
                    "verified": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/complaints": {
      "post": {
        "tags": [
          "Grievances & Complaints"
        ],
        "summary": "Submit Trade Grievance",
        "description": "Allows members and the trading public to formally lodge trade grievances, demurrage disputes, or customs operational issues directly into the Secretariat registry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplaintSubmission"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Complaint successfully lodged",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "complaint_id": "CMP-2026-62358",
                  "tracking_token": "085b01758a64e41b847d019ebf52cda9",
                  "message": "Complaint lodged successfully. Keep your tracking token secure.",
                  "data": {
                    "complaint_id": "CMP-2026-62358",
                    "port": "Tema Port",
                    "category": "Port Demurrage Dispute",
                    "status": "Received"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/complaints/track/{complaint_id}": {
      "get": {
        "tags": [
          "Grievances & Complaints"
        ],
        "summary": "Track Grievance Progression",
        "description": "Retrieves real-time stage progression and committee timeline for a previously submitted complaint. Requires the tracking token issued at submission.",
        "parameters": [
          {
            "name": "complaint_id",
            "in": "path",
            "required": true,
            "description": "Official Complaint ID (e.g. CMP-2026-62358)",
            "schema": {
              "type": "string"
            },
            "example": "CMP-2026-62358"
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Tracking secret token issued upon lodgement",
            "schema": {
              "type": "string"
            },
            "example": "085b01758a64e41b847d019ebf52cda9"
          }
        ],
        "responses": {
          "200": {
            "description": "Grievance progression status and committee milestones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintTrackerResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid tracking token"
          },
          "404": {
            "description": "Complaint ID not found"
          }
        }
      }
    },
    "/api/v1/public/members": {
      "get": {
        "tags": [
          "Directory & Ports"
        ],
        "summary": "Accredited Members Directory",
        "description": "Returns list of officially accredited freight forwarding and customs brokerage firms in Ghana.",
        "parameters": [
          {
            "name": "port",
            "in": "query",
            "required": false,
            "description": "Filter by operating port (e.g. Tema Port, Takoradi Port, KIA)",
            "schema": {
              "type": "string"
            },
            "example": "Tema Port"
          }
        ],
        "responses": {
          "200": {
            "description": "List of accredited members",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    {
                      "membership_id": "CUBAG-2026-0008",
                      "company_name": "Antwi Nyame Freight Services Ltd",
                      "status": "Active",
                      "standing": "Good Standing",
                      "port": "Tema Port"
                    }
                  ],
                  "total": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/ports": {
      "get": {
        "tags": [
          "Directory & Ports"
        ],
        "summary": "Operational Ports Directory",
        "description": "Returns all active ports, frontiers, and cargo terminals where CUBAG operates in Ghana.",
        "responses": {
          "200": {
            "description": "List of ports",
            "content": {
              "application/json": {
                "example": {
                  "ports": [
                    {
                      "name": "Tema Port",
                      "code": "GH-TEM",
                      "type": "Sea Port",
                      "region": "Greater Accra"
                    },
                    {
                      "name": "Takoradi Port",
                      "code": "GH-TKD",
                      "type": "Sea Port",
                      "region": "Western Region"
                    },
                    {
                      "name": "Kotoka International Airport (KIA)",
                      "code": "GH-ACC",
                      "type": "Air Cargo Terminal",
                      "region": "Greater Accra"
                    },
                    {
                      "name": "Aflao Border",
                      "code": "GH-AFL",
                      "type": "Land Frontier",
                      "region": "Volta Region"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/news": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "Maritime & Operational News",
        "description": "Returns vetted port trade alerts, shipping line notices, ICUMS operational updates, and association news.",
        "responses": {
          "200": {
            "description": "Recent news items",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    {
                      "id": 1,
                      "title": "ICUMS System Maintenance Notice",
                      "category": "Operational",
                      "date": "2026-11-08",
                      "summary": "Ghana Revenue Authority ICUMS scheduled downtime notice."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/bulletins": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "Official Secretariat Bulletins",
        "description": "Official press releases and compliance directives published by the Executive Committee.",
        "responses": {
          "200": {
            "description": "Bulletins list",
            "content": {
              "application/json": {
                "example": {
                  "items": []
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/events": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "Upcoming Events & Seminars",
        "description": "Lists upcoming trade conferences, general meetings, and stakeholder seminars.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "all"
          }
        ],
        "responses": {
          "200": {
            "description": "Upcoming events",
            "content": {
              "application/json": {
                "example": {
                  "items": []
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/courses": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "CTI Professional Training Courses",
        "description": "Returns active customs clearance, brokerage, tariff valuation, and freight forwarding training courses organized by the Customs Training Institute (CTI).",
        "responses": {
          "200": {
            "description": "Available training courses",
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    {
                      "id": 1,
                      "title": "Freight Forwarding Fundamentals",
                      "duration": "4 Weeks",
                      "fee": "GHS 1",
                      "mode": "Hybrid",
                      "start_date": "15 Dec 2026",
                      "description": "Foundational customs clearance and brokerage procedures."
                    }
                  ],
                  "total": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/gallery": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "Photo Gallery",
        "description": "Photo albums from association events, executive inaugurations, and port inspection visits.",
        "responses": {
          "200": {
            "description": "Gallery albums",
            "content": {
              "application/json": {
                "example": {
                  "items": []
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/surveys": {
      "get": {
        "tags": [
          "Publications & Events"
        ],
        "summary": "Active Public & Member Surveys",
        "description": "Current surveys gathering feedback on port efficiency, shipping line fees, and customs delays.",
        "responses": {
          "200": {
            "description": "Active surveys",
            "content": {
              "application/json": {
                "example": {
                  "items": []
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PortalSummary": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "stats": {
            "type": "object",
            "properties": {
              "active_members": {
                "type": "integer",
                "example": 152
              },
              "operating_ports": {
                "type": "integer",
                "example": 4
              },
              "compliance_rate": {
                "type": "integer",
                "example": 98
              }
            }
          },
          "hero": {
            "type": "object"
          },
          "news": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "announcements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "VerifyMemberResult": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean",
            "example": true
          },
          "member": {
            "type": "object",
            "properties": {
              "membership_id": {
                "type": "string",
                "example": "CUBAG-2026-0008"
              },
              "company_name": {
                "type": "string",
                "example": "Antwi Nyame Freight Services Ltd"
              },
              "status": {
                "type": "string",
                "example": "Active"
              },
              "standing": {
                "type": "string",
                "example": "Good Standing"
              },
              "port": {
                "type": "string",
                "example": "Tema Port"
              }
            }
          }
        }
      },
      "ComplaintSubmission": {
        "type": "object",
        "required": [
          "name",
          "email",
          "category",
          "subject",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Kwame Asante"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "kwame.asante@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+233244000111"
          },
          "category": {
            "type": "string",
            "example": "Port Demurrage Dispute"
          },
          "port": {
            "type": "string",
            "example": "Tema Port"
          },
          "target_entity": {
            "type": "string",
            "example": "Shipping Line Agency"
          },
          "subject": {
            "type": "string",
            "example": "Excess Detention Charge Assessment"
          },
          "description": {
            "type": "string",
            "example": "Container released within free days but detention invoices billed at gate out."
          },
          "hp_field": {
            "type": "string",
            "description": "Anti-spam honeypot field, must be empty",
            "example": ""
          }
        }
      },
      "ComplaintTrackerResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "complaint_id": {
                "type": "string",
                "example": "CMP-2026-62358"
              },
              "category": {
                "type": "string",
                "example": "Port Demurrage Dispute"
              },
              "port": {
                "type": "string",
                "example": "Tema Port"
              },
              "status": {
                "type": "string",
                "example": "Received"
              },
              "created_at": {
                "type": "string",
                "example": "2026-11-09T18:39:53.484215"
              },
              "timeline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "integer",
                      "example": 1
                    },
                    "title": {
                      "type": "string",
                      "example": "Complaint Lodged"
                    },
                    "desc": {
                      "type": "string"
                    },
                    "done": {
                      "type": "boolean",
                      "example": true
                    },
                    "active": {
                      "type": "boolean",
                      "example": true
                    },
                    "date": {
                      "type": "string",
                      "example": "09 Nov 2026, 06:39 PM"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}