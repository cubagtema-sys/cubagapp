  "components": {
    "schemas": {
      "PortalSummary": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "stats": {
            "type": "object"
          },
          "hero": {
            "type": "object"
          },
          "announcements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "news": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "surveys": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "VerifyMemberResponse": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "member": {
            "type": "object",
            "properties": {
              "membership_id": {
                "type": "string"
              },
              "company_name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "standing": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "port": {
                "type": "string"
              }
            }
          }
        }
      },
      "ComplaintSubmission": {
        "type": "object",
        "required": [
          "name",
          "email",
          "category",
          "subject",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Kwame Asante"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "kwame.asante@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+233244000111"
          },
          "category": {
            "type": "string",
            "example": "Port Demurrage Dispute"
          },
          "port": {
            "type": "string",
            "example": "Tema Port"
          },
          "target_entity": {
            "type": "string",
            "example": "Shipping Line Agency"
          },
          "subject": {
            "type": "string",
            "example": "Excess Detention Charge Assessment"
          },
          "description": {
            "type": "string",
            "example": "Container released within free days but detention invoices billed at gate out."
          },
          "hp_field": {
            "type": "string",
            "description": "Honeypot anti-spam field, must be left blank",
            "example": ""
          }
        }
      }
    }
  }
}