# Global platform definition for iOS
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '1600'
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
    config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGES'] = ''
      config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS'] = ''
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      
      # Clean stale/missing cryptex toolchain search paths
      ['LIBRARY_SEARCH_PATHS', 'FRAMEWORK_SEARCH_PATHS', 'SWIFT_INCLUDE_PATHS'].each do |setting|
        if config.build_settings[setting]
          paths = config.build_settings[setting]
          if paths.is_a?(Array)
            config.build_settings[setting] = paths.reject { |p| p.to_s.include?('cryptexd') }
          elsif paths.is_a?(String) && paths.include?('cryptexd')
            config.build_settings[setting] = '$(inherited)'
          end
        end
      end
    end
  end

  installer.pod_targets.each do |pod_target|
    if pod_target.respond_to?(:native_target) && pod_target.native_target
      pod_target.native_target.build_configurations.each do |config|
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
        config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
        config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGES'] = ''
        config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS'] = ''
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end

  installer.pods_project.save

  # Directly enforce in Pods project.pbxproj
  pbxproj_path = File.join(__dir__, 'Pods', 'Pods.xcodeproj', 'project.pbxproj')
  if File.exist?(pbxproj_path)
    pbx_content = File.read(pbxproj_path)
    pbx_content.gsub!('ENABLE_MODULE_VERIFIER = YES;', 'ENABLE_MODULE_VERIFIER = NO;')
    File.write(pbxproj_path, pbx_content)
  end

  # Also write to all generated xcconfig files to guarantee Xcode respects it
  Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_file|
    content = File.read(xcconfig_file)
    additions = []
    additions << 'ENABLE_MODULE_VERIFIER = NO' unless content.include?('ENABLE_MODULE_VERIFIER = NO')
    additions << 'CLANG_ENABLE_MODULE_VERIFIER = NO' unless content.include?('CLANG_ENABLE_MODULE_VERIFIER = NO')
    additions << 'MODULE_VERIFIER_SUPPORTED_LANGUAGES =' unless content.include?('MODULE_VERIFIER_SUPPORTED_LANGUAGES =')
    additions << 'MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS =' unless content.include?('MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS =')
    additions << 'CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO' unless content.include?('CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO')
    additions << 'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES' unless content.include?('CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES')
    unless additions.empty?
      File.open(xcconfig_file, 'a') { |f| f.puts "\n" + additions.join("\n") }
    end
  end
end
