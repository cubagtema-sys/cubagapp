<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (http) is disabled globally (usesCleartextTraffic="false") but is
  explicitly permitted for local development addresses only, so the app can talk
  to a LAN/desktop dev backend (http://192.168.4.127:5005) even in release builds.
  All remote/production traffic must use https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.127</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
